# WatsonX AI Configuration
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_API_PROJECT_ID=your_project_id_here

# Database Configuration
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=advisory_intelligence
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_SCHEMA=concert_advisory

# For SQLite (development), set DB_TYPE=sqlite and DB_NAME to file path
# DB_TYPE=sqlite
# DB_NAME=./advisory_intelligence.db

# For PostgreSQL (production), set DB_TYPE=postgresql
# DB_TYPE=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=advisory_intelligence
# DB_USERNAME=postgres
# DB_PASSWORD=your_password_here
# DB_SCHEMA=concert_advisory